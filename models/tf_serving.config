# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# TensorFlow Serving — Model Configuration
#
# TF Serving will serve all three models simultaneously.
# Each model is available at:
#   REST: http://localhost:8501/v1/models/{model_name}:predict
#   gRPC: localhost:8500
#
# CHANGE: base_path entries must match the volume mounts
# in docker-compose.yml and your trained model directories.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model_config_list {

  config {
    name:           "damage_model"
    base_path:      "/models/damage_model"
    model_platform: "tensorflow"
    # CHANGE: to "tensorflow" once your model is trained and exported
    # model_version_policy { latest { num_versions: 1 } }
  }

  config {
    name:           "vehicle_model"
    base_path:      "/models/vehicle_model"
    model_platform: "tensorflow"
  }

  config {
    name:           "plate_model"
    base_path:      "/models/plate_model"
    model_platform: "tensorflow"
  }

}
